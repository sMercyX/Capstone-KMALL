########################################
# KMALL - oauth2-proxy (.env)
########################################

########## 1) PORT & REDIRECT ##########
# oauth2-proxy จะฟังที่ port 4180 ใน container
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180

# callback URL ที่ลงทะเบียนไว้ใน Azure AD
OAUTH2_PROXY_REDIRECT_URL=https://bscit.sit.kmutt.ac.th/capstone25/cp25ssa2/oauth2/callback


########## 2) MICROSOFT ENTRA ID (AZURE AD) ##########
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/6f4432dc-20d2-441d-b1db-ac3380ba633d/v2.0

# ใช้ค่าจริงของคุณที่มีอยู่แล้ว
OAUTH2_PROXY_CLIENT_ID=48b742ee-fc8e-4c64-8d73-67548f807422
OAUTH2_PROXY_CLIENT_SECRET=tg28Q~IxslMeAHGI_T12f8ZVfs~qh6uearH.Ebuw

# scope สำหรับดึง identity (มี openid + profile + email ก็พอ)
OAUTH2_PROXY_SCOPE=openid profile email

# map claim ของ Azure → user id + email
OAUTH2_PROXY_USER_ID_CLAIM=oid
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=preferred_username


########## 3) BACKEND (API UPSTREAM) ##########
# ให้ oauth2-proxy ยิงต่อไปที่ backend container
OAUTH2_PROXY_UPSTREAMS=http://capstone-backend:8080


########## 4) PROXY / COOKIE & SECURITY ##########
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_PROXY_PREFIX=/oauth2

# ชื่อ cookie ที่ใช้เก็บ session ของ oauth2-proxy
OAUTH2_PROXY_COOKIE_NAME=_kmall_oauth

# domain ที่ cookie ใช้ได้ (ตัวจริงของคุณ)
OAUTH2_PROXY_COOKIE_DOMAINS=bscit.sit.kmutt.ac.th

# ให้ cookie ใช้ได้เฉพาะใต้ prefix app ของเรา
OAUTH2_PROXY_COOKIE_PATH=/capstone25/cp25ssa2

# ค่าพวกนี้โอเคแล้วสำหรับ production
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax

# allow email domain จาก KMUTT เท่านั้น
OAUTH2_PROXY_EMAIL_DOMAINS=kmutt.ac.th

# whitelist domain ที่จะถูก redirect กลับไปได้
OAUTH2_PROXY_WHITELIST_DOMAINS=bscit.sit.kmutt.ac.th,bscit.sit.kmutt.ac.th:443,login.microsoftonline.com

# ใช้ secret เดิมของคุณ ห้ามเปลี่ยนถ้าไม่จำเป็น
OAUTH2_PROXY_COOKIE_SECRET=nJIRzw5sEO9Eu9OwRIybr2n4pmHI9bSfc0NOtuzU6H8=


########## 5) SESSION STORE (REDIS) ##########
OAUTH2_PROXY_SESSION_STORE_TYPE=redis
OAUTH2_PROXY_REDIS_CONNECTION_URL=redis://redis:6379


########## 6) HEALTH & DEBUG ##########
# health check ไม่ต้อง login
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/oauth2/health$

# ให้แสดงหน้า error แบบ debug เวลา upstream พัง
OAUTH2_PROXY_SHOW_DEBUG_ON_ERROR=true


########## 7) HEADER / LOGIN FLOW ##########
# ใช้ single provider (ไม่ต้องเลือกที่หน้าจอ)
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# ให้เซ็ต X-Auth-Request-* header เพื่อใช้ใน middleware.UpstreamAuth()
OAUTH2_PROXY_SET_XAUTHREQUEST=true

# ให้ forward user headers จาก IdP (บางตัวจะเติม header เพิ่ม)
OAUTH2_PROXY_PASS_USER_HEADERS=true

# ส่ง access token / Authorization header ต่อไปหา backend ด้วย
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true